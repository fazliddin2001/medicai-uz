<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>MedicAI - High-Reliability Clinical Intelligence</title>
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link href="/css/style.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
</head>
<body class="bg-surface font-body-md text-on-surface antialiased">
    <!-- TopNavBar -->
    <header class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-md dark:bg-surface-container-high/80 shadow-[0_4px_20px_rgba(90,107,135,0.08)] shadow-sm transition-all duration-300 ease-in-out">
        <div class="flex justify-between items-center max-w-container-max mx-auto px-margin-desktop h-20">
            <a href="/<%= lang %>" class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">medical_services</span>
                <span class="font-headline-md text-headline-md font-bold text-on-surface dark:text-on-surface-variant">MedicAI</span>
            </a>
            <nav class="hidden md:flex items-center gap-8">
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-secondary transition-colors hover:scale-105 duration-200" href="#features"><%= nav_features %></a>
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-secondary transition-colors hover:scale-105 duration-200" href="#solutions"><%= nav_solutions %></a>
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-secondary transition-colors hover:scale-105 duration-200" href="#technology"><%= nav_technology %></a>
            </nav>
            <div class="flex items-center gap-4">
                <div class="relative group">
                    <button class="flex items-center gap-2 font-label-md text-label-md text-on-surface-variant bg-surface-container-low rounded-full px-4 py-2 hover:bg-surface-container-high transition-colors cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">language</span>
                        <span><%= current_lang_label %></span>
                    </button>
                    <div class="absolute right-0 mt-2 w-32 bg-surface rounded-xl shadow-lg border border-outline-variant/30 z-20 hidden group-focus-within:block py-2">
                        <a class="block px-4 py-2 font-label-md text-label-md text-on-surface hover:bg-surface-container-low hover:text-secondary transition-colors" href="/uz">UZ</a>
                        <a class="block px-4 py-2 font-label-md text-label-md text-on-surface hover:bg-surface-container-low hover:text-secondary transition-colors" href="/en">EN</a>
                        <a class="block px-4 py-2 font-label-md text-label-md text-on-surface hover:bg-surface-container-low hover:text-secondary transition-colors" href="/ru">RU</a>
                    </div>
                </div>
                <a href="#connect" class="hidden sm:inline-block font-label-md text-label-md text-secondary border border-secondary rounded-full px-6 py-2 hover:bg-surface-container-low transition-colors"><%= nav_contact %></a>
                <a href="https://model.medicai.uz/medicai.apk" class="font-label-md text-label-md bg-secondary text-on-secondary rounded-full px-6 py-2 hover:scale-105 transition-transform duration-200 shadow-sm inline-flex items-center gap-1">
                    <span class="material-symbols-outlined text-[18px]">download</span>
                    <%= nav_get_started %>
                </a>
            </div>
        </div>
    </header>

    <main class="pt-24 pb-32">
        <!-- Hero Section -->
        <section class="glacier-gradient min-h-[80vh] flex items-center pt-12 sm:pt-16 relative overflow-hidden">
            <div class="max-w-container-max mx-auto px-margin-desktop grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center relative z-10 w-full">
                <div class="lg:col-span-7 bg-surface rounded-xl p-6 sm:p-10 border border-surface-container-high soft-shadow relative overflow-hidden group">
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-container-high border border-outline-variant/30 mb-6">
                        <span class="material-symbols-outlined text-secondary text-[16px]">verified</span>
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider"><%= hero_badge %></span>
                    </div>
                    <h1 class="font-headline-xl text-3xl sm:text-4xl md:text-[40px] leading-tight sm:leading-[48px] font-extrabold text-on-surface mb-6">
                        <%= hero_title_1 %> <br>
                        <span class="text-secondary"><%= hero_title_2 %></span>
                    </h1>
                    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl mb-8">
                        <%= hero_desc %>
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a href="https://model.medicai.uz/medicai.apk" class="font-label-md text-label-md bg-secondary text-on-secondary rounded-full px-8 py-4 hover:scale-105 transition-transform duration-200 shadow-lg shadow-secondary/20 inline-flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">download</span>
                            <%= hero_cta_experience %>
                        </a>
                        <a href="https://github.com/fazliddin2001/medicai/releases/latest" target="_blank" class="font-label-md text-label-md bg-transparent border border-secondary text-secondary rounded-full px-8 py-4 hover:bg-surface-container-low transition-colors inline-flex items-center justify-center gap-2">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                            <%= hero_cta_explore %>
                        </a>
                        <a href="https://t.me/medicaiuz" target="_blank" aria-label="Telegram" class="font-label-md text-label-md bg-transparent border border-secondary text-secondary rounded-full w-14 h-14 hover:bg-surface-container-low transition-colors inline-flex items-center justify-center">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.121l-6.869 4.326-2.96-.924c-.64-.203-.658-.64.135-.954l11.566-4.458c.538-.196 1.006.128.832.941z"/>
                            </svg>
                        </a>
                    </div>
                </div>
                <div class="lg:col-span-5 bg-surface rounded-xl p-8 border border-surface-container-high soft-shadow flex flex-col justify-center items-center relative min-h-[380px]">
                    <!-- Abstract representation of Dual Mode -->
                    <div class="absolute inset-0 bg-secondary/5 rounded-full blur-3xl"></div>
                    <div class="relative z-10 flex flex-col sm:flex-row gap-6 floating-element items-center justify-center w-full">
                        <!-- Cloud Node -->
                        <div class="bg-surface rounded-xl p-6 border border-surface-container-high soft-shadow w-56 sm:w-48 flex flex-col items-center text-center">
                            <div class="w-14 h-14 rounded-full bg-secondary-container flex items-center justify-center mb-4">
                                <span class="material-symbols-outlined text-on-secondary-container text-2xl">cloud</span>
                            </div>
                            <h3 class="font-headline-sm text-lg text-on-surface mb-1 font-bold"><%= hero_cloud_title %></h3>
                            <p class="font-body-sm text-xs text-on-surface-variant"><%= hero_cloud_sub %></p>
                        </div>
                        <!-- Edge Node -->
                        <div class="bg-surface rounded-xl p-6 border border-surface-container-high soft-shadow w-56 sm:w-48 flex flex-col items-center text-center sm:mt-12">
                            <div class="w-14 h-14 rounded-full bg-secondary-container flex items-center justify-center mb-4">
                                <span class="material-symbols-outlined text-on-secondary-container text-2xl">shield</span>
                            </div>
                            <h3 class="font-headline-sm text-lg text-on-surface mb-1 font-bold"><%= hero_edge_title %></h3>
                            <p class="font-body-sm text-xs text-on-surface-variant"><%= hero_edge_sub %></p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section id="features" class="py-24 bg-surface">
            <div class="max-w-container-max mx-auto px-margin-desktop">
                <div class="text-center max-w-2xl mx-auto mb-16">
                    <h2 class="font-headline-lg text-3xl sm:text-4xl font-bold text-on-surface mb-4"><%= features_section_title %></h2>
                    <p class="font-body-md text-body-md text-on-surface-variant"><%= features_section_desc %></p>
                </div>
                <div id="solutions" class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Web API Card -->
                    <div class="bg-[#F0F9FF] rounded-xl p-8 sm:p-10 border border-[#E1EFFE] soft-shadow hover:scale-[1.02] transition-transform duration-300 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start mb-12">
                                <div class="w-16 h-16 rounded-full bg-secondary-container flex items-center justify-center shadow-inner">
                                    <span class="material-symbols-outlined text-on-secondary-container text-3xl">cloud</span>
                                </div>
                                <div class="inline-flex items-center gap-2 bg-surface px-3 py-1.5 rounded-full border border-outline-variant/30">
                                    <span class="material-symbols-outlined text-secondary text-[14px]">wifi</span>
                                    <span class="font-label-sm text-label-sm text-on-surface"><%= card_cloud_badge %></span>
                                </div>
                            </div>
                            <h3 class="font-headline-md text-headline-md font-bold text-on-surface mb-2"><%= card_cloud_title %></h3>
                            <p class="font-body-md text-body-md text-secondary font-medium mb-6"><%= card_cloud_tag %></p>
                            <div class="w-12 h-0.5 bg-secondary-container mb-6"></div>
                            <p class="font-body-md text-body-md text-on-surface-variant">
                                <%= card_cloud_desc %>
                            </p>
                        </div>
                    </div>
                    <!-- On-Device AI Card -->
                    <div class="bg-[#F0F9FF] rounded-xl p-8 sm:p-10 border border-[#E1EFFE] soft-shadow hover:scale-[1.02] transition-transform duration-300 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start mb-12">
                                <div class="w-16 h-16 rounded-full bg-secondary-container flex items-center justify-center shadow-inner">
                                    <span class="material-symbols-outlined text-on-secondary-container text-3xl">shield</span>
                                </div>
                                <div class="inline-flex items-center gap-2 bg-surface px-3 py-1.5 rounded-full border border-outline-variant/30">
                                    <span class="material-symbols-outlined text-secondary text-[14px]">check_circle</span>
                                    <span class="font-label-sm text-label-sm text-on-surface"><%= card_edge_badge %></span>
                                </div>
                            </div>
                            <h3 class="font-headline-md text-headline-md font-bold text-on-surface mb-2"><%= card_edge_title %></h3>
                            <p class="font-body-md text-body-md text-secondary font-medium mb-6"><%= card_edge_tag %></p>
                            <div class="w-12 h-0.5 bg-secondary-container mb-6"></div>
                            <p class="font-body-md text-body-md text-on-surface-variant">
                                <%= card_edge_desc %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Capabilities Bento Grid -->
        <section id="technology" class="py-24 glacier-gradient">
            <div class="max-w-container-max mx-auto px-margin-desktop">
                <div class="mb-16">
                    <h2 class="font-headline-lg text-3xl sm:text-4xl font-bold text-on-surface mb-4"><%= capabilities_section_title %></h2>
                    <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl"><%= capabilities_section_desc %></p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                    <!-- Image Analysis (Large) -->
                    <div class="md:col-span-6 bg-surface rounded-xl p-8 border border-surface-container-high soft-shadow relative overflow-hidden group flex flex-col justify-between min-h-[300px]">
                        <div class="relative z-10">
                            <div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center mb-6">
                                <span class="material-symbols-outlined text-on-secondary-container">radiology</span>
                            </div>
                            <h3 class="font-headline-md text-xl sm:text-2xl font-bold text-on-surface mb-4"><%= cap_image_title %></h3>
                            <p class="font-body-md text-body-md text-on-surface-variant">
                                <%= cap_image_desc %>
                            </p>
                        </div>
                    </div>
                    <!-- Document Management (Small) -->
                    <div class="md:col-span-6 bg-surface rounded-xl p-8 border border-surface-container-high soft-shadow flex flex-col justify-between min-h-[300px]">
                        <div>
                            <div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center mb-6">
                                <span class="material-symbols-outlined text-on-secondary-container">description</span>
                            </div>
                            <h3 class="font-headline-sm text-xl sm:text-2xl font-bold text-on-surface mb-4"><%= cap_doc_title %></h3>
                        </div>
                        <p class="font-body-sm text-base text-on-surface-variant">
                            <%= cap_doc_desc %>
                        </p>
                    </div>
                    <!-- Training Corpora (Full Width) -->
                    <div class="md:col-span-12 bg-secondary text-on-secondary rounded-xl p-8 sm:p-10 soft-shadow relative overflow-hidden flex items-center min-h-[280px]">
                        <div class="relative z-10 max-w-3xl">
                            <div class="inline-flex items-center gap-2 bg-on-secondary/10 px-3 py-1.5 rounded-full mb-6 border border-on-secondary/20">
                                <span class="material-symbols-outlined text-on-secondary text-[14px]">school</span>
                                <span class="font-label-sm text-label-sm text-on-secondary uppercase tracking-wider"><%= cap_foundation_badge %></span>
                            </div>
                            <h3 class="font-headline-md text-2xl sm:text-3xl font-bold text-on-secondary mb-4"><%= cap_foundation_title %></h3>
                            <p class="font-body-lg text-base sm:text-lg text-secondary-fixed opacity-90 leading-relaxed">
                                <%= cap_foundation_desc %>
                            </p>
                        </div>
                        <div class="absolute right-0 top-0 bottom-0 w-1/3 opacity-20 pointer-events-none flex items-center justify-end pr-6 hidden md:flex">
                            <span class="material-symbols-outlined text-[240px] leading-none" style="font-variation-settings: 'FILL' 1;">database</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Connect Section (A24 style buttons) -->
        <section id="connect" class="py-20 bg-surface">
            <div class="max-w-container-max mx-auto px-margin-desktop text-center">
                <h2 class="font-headline-lg text-3xl sm:text-4xl font-bold text-on-surface mb-4"><%= connect_title %></h2>
                <p class="font-body-md text-body-md text-on-surface-variant max-w-xl mx-auto mb-10">
                    <%= connect_desc %>
                </p>
                <div class="flex items-center justify-center gap-6">
                    <a href="mailto:support@medicai.uz" aria-label="Email Us" class="flex items-center justify-center w-16 h-16 bg-surface-container-low rounded-full border border-outline-variant/30 hover:border-secondary hover:bg-secondary-container transition-all group shadow-sm">
                        <span class="material-symbols-outlined text-3xl text-secondary group-hover:scale-110 transition-transform">email</span>
                    </a>
                    <a href="https://t.me/medicaiuz" target="_blank" aria-label="Telegram" class="flex items-center justify-center w-16 h-16 bg-surface-container-low rounded-full border border-outline-variant/30 hover:border-secondary hover:bg-secondary-container transition-all group shadow-sm">
                        <svg class="w-7 h-7 text-secondary group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.121l-6.869 4.326-2.96-.924c-.64-.203-.658-.64.135-.954l11.566-4.458c.538-.196 1.006.128.832.941z"/>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-surface-container-low dark:bg-surface-container-lowest w-full py-16 border-t border-outline-variant/30">
        <div class="max-w-container-max mx-auto px-margin-desktop grid grid-cols-1 md:grid-cols-4 gap-gutter items-center">
            <div class="col-span-1 md:col-span-2">
                <div class="flex items-center gap-2 mb-3">
                    <span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">medical_services</span>
                    <span class="font-headline-sm text-headline-sm font-bold text-secondary">MedicAI</span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant max-w-sm">
                    <%= footer_rights %>
                </p>
            </div>
            <div class="col-span-1 md:col-span-2 flex flex-wrap gap-x-6 gap-y-3 md:justify-end">
                <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-secondary hover:underline transition-all opacity-90 hover:opacity-100" href="#"><%= footer_privacy %></a>
                <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-secondary hover:underline transition-all opacity-90 hover:opacity-100" href="#"><%= footer_terms %></a>
                <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-secondary hover:underline transition-all opacity-90 hover:opacity-100" href="#"><%= footer_security %></a>
                <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-secondary hover:underline transition-all opacity-90 hover:opacity-100" href="#"><%= footer_regulatory %></a>
            </div>
        </div>
    </footer>
</body>
</html>